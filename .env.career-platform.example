# Local demo defaults. Do not commit the copied .env.career-platform file.
# PostgreSQL is required by Docker Compose; SQLite is suitable only for local demos.
CAREER_AGENT_DATABASE_URL=postgresql+psycopg://careeragent:careeragent@postgres:5432/careeragent
CAREER_AGENT_QDRANT_URL=http://qdrant:6333
CAREER_AGENT_ADMIN_TOKEN=replace-with-a-long-random-secret

# Data lifecycle settings
CAREER_AGENT_GREENHOUSE_BOARDS=airtable
CAREER_AGENT_SCHEDULER_ENABLED=true
CAREER_AGENT_SCHEDULER_HOUR_UTC=2
CAREER_AGENT_MISSING_SYNC_THRESHOLD=2
CAREER_AGENT_HISTORY_RETENTION_DAYS=1095

# Official Chinese sources. Baidu's 2027 campus board is publicly rendered,
# but only its visible first page is consumed, so it never auto-closes jobs.
CAREER_AGENT_BAIDU_CAMPUS_ENABLED=true
# PDD's public campus list is paginated and exposes stable IDs and JDs. It is
# intentionally non-authoritative until removal semantics are verified.
CAREER_AGENT_PDD_CAMPUS_ENABLED=true
# Shopee's official public Moka interface exposes complete paginated lists for
# campus recruitment, AI Star Program, and R&D internships.
CAREER_AGENT_SHOPEE_CAMPUS_ENABLED=true
# JoinQuant and NVIDIA use the same public Moka pagination contract. Their
# public boards are treated as authoritative sources.
CAREER_AGENT_JOINQUANT_CAMPUS_ENABLED=true
CAREER_AGENT_NVIDIA_CAMPUS_ENABLED=true
# Lenovo China's public board exposes a complete paginated list with stable
# IDs and full responsibilities/requirements, and is authoritative.
CAREER_AGENT_LENOVO_CAMPUS_ENABLED=true
# Kuaishou's public endpoint has a verified full-list contract. Keep it off
# until its current recruitment-project code is manually revalidated.
CAREER_AGENT_KUAISHOU_CAMPUS_ENABLED=false

# Optional local Ollama Agent. Enable only after `ollama list` shows this model.
CAREER_AGENT_LLM_ENABLED=true
CAREER_AGENT_LLM_PROVIDER=ollama
CAREER_AGENT_LLM_MODEL=career-qwen3:4b
# Docker Desktop reaches an Ollama service running on the host via this address.
CAREER_AGENT_LLM_BASE_URL=http://host.docker.internal:11434/v1
CAREER_AGENT_LLM_TIMEOUT_SECONDS=120
CAREER_AGENT_LLM_MAX_OUTPUT_TOKENS=128
